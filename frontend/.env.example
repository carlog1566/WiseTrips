# FastAPI backend URL (select the URL for the device you use)
# iOS Simulator: http://127.0.0.1:8000
# Android Emulator: http://10.0.2.2:8000
# Physical phone: http://YOUR_COMPUTER_LAN_IP:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: restricted Android Maps SDK key for native Android builds.
# Do not put your private/unrestricted backend GOOGLE_MAPS_API_KEY here.
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_RESTRICTED_MAPS_API_KEY